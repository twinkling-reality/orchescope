{
  "$id": "urn:orchescope:schema:manifest:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "definedAtLine": {
            "minimum": 1,
            "type": "integer"
          },
          "definedIn": {
            "description": "Repository relative POSIX path.",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string"
          },
          "displayName": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "entrypoint",
                "type": "string"
              },
              {
                "const": "agent",
                "type": "string"
              },
              {
                "const": "agent_group",
                "type": "string"
              },
              {
                "const": "model",
                "type": "string"
              },
              {
                "const": "provider",
                "type": "string"
              },
              {
                "const": "prompt",
                "type": "string"
              },
              {
                "const": "tool",
                "type": "string"
              },
              {
                "const": "mcp_server",
                "type": "string"
              },
              {
                "const": "memory",
                "type": "string"
              },
              {
                "const": "retrieval",
                "type": "string"
              },
              {
                "const": "queue",
                "type": "string"
              },
              {
                "const": "database",
                "type": "string"
              },
              {
                "const": "external_service",
                "type": "string"
              },
              {
                "const": "approval_boundary",
                "type": "string"
              },
              {
                "const": "side_effect",
                "type": "string"
              },
              {
                "const": "evaluator",
                "type": "string"
              }
            ],
            "description": "Kind of component in the unified agent system model."
          },
          "metadata": {
            "description": "Shallow, JSON scalar metadata. Never used to carry secrets.",
            "patternProperties": {
              "^(.*)$": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    },
                    "type": "array"
                  }
                ]
              }
            },
            "type": "object"
          },
          "name": {
            "description": "Semantic name, becomes the component local name.",
            "minLength": 1,
            "type": "string"
          },
          "permissions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "declaredIn": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "endColumn": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "endLine": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "file": {
                          "description": "Repository relative POSIX path.",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                          "type": "string"
                        },
                        "fileHash": {
                          "description": "Lowercase hexadecimal SHA-256 digest.",
                          "pattern": "^[0-9a-f]{64}$",
                          "type": "string"
                        },
                        "startColumn": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "startLine": {
                          "minimum": 1,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "file",
                        "startLine"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "description": "Repository relative POSIX path.",
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
                          "type": "string"
                        },
                        "fileHash": {
                          "description": "Lowercase hexadecimal SHA-256 digest.",
                          "pattern": "^[0-9a-f]{64}$",
                          "type": "string"
                        },
                        "pointer": {
                          "pattern": "^(?:/(?:[^/~]|~[01])*)*$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "file",
                        "pointer"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "filesystem",
                      "type": "string"
                    },
                    {
                      "const": "network",
                      "type": "string"
                    },
                    {
                      "const": "process",
                      "type": "string"
                    },
                    {
                      "const": "model",
                      "type": "string"
                    },
                    {
                      "const": "secret",
                      "type": "string"
                    },
                    {
                      "const": "database",
                      "type": "string"
                    },
                    {
                      "const": "queue",
                      "type": "string"
                    },
                    {
                      "const": "mcp",
                      "type": "string"
                    }
                  ]
                },
                "mode": {
                  "anyOf": [
                    {
                      "const": "read",
                      "type": "string"
                    },
                    {
                      "const": "write",
                      "type": "string"
                    },
                    {
                      "const": "execute",
                      "type": "string"
                    }
                  ]
                },
                "scope": {
                  "description": "Resource the permission applies to, for example a host or path.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "scope",
                "mode"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "runtimeName": {
            "minLength": 1,
            "type": "string"
          },
          "sideEffect": {
            "anyOf": [
              {
                "const": "read_only",
                "type": "string"
              },
              {
                "const": "idempotent_write",
                "type": "string"
              },
              {
                "const": "non_idempotent_write",
                "type": "string"
              },
              {
                "const": "external_notification",
                "type": "string"
              },
              {
                "const": "financial",
                "type": "string"
              },
              {
                "const": "destructive",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "tags": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "Component name declared in this manifest or discovered name.",
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "contains",
                "type": "string"
              },
              {
                "const": "invokes_model",
                "type": "string"
              },
              {
                "const": "calls_tool",
                "type": "string"
              },
              {
                "const": "hands_off_to",
                "type": "string"
              },
              {
                "const": "uses_prompt",
                "type": "string"
              },
              {
                "const": "reads_memory",
                "type": "string"
              },
              {
                "const": "writes_memory",
                "type": "string"
              },
              {
                "const": "queries_retrieval",
                "type": "string"
              },
              {
                "const": "publishes_to_queue",
                "type": "string"
              },
              {
                "const": "consumes_from_queue",
                "type": "string"
              },
              {
                "const": "calls_service",
                "type": "string"
              },
              {
                "const": "queries_database",
                "type": "string"
              },
              {
                "const": "provides_tool",
                "type": "string"
              },
              {
                "const": "served_by_provider",
                "type": "string"
              },
              {
                "const": "falls_back_to",
                "type": "string"
              },
              {
                "const": "guarded_by",
                "type": "string"
              },
              {
                "const": "performs_side_effect",
                "type": "string"
              },
              {
                "const": "validated_by",
                "type": "string"
              },
              {
                "const": "observed_after",
                "type": "string"
              }
            ],
            "description": "Kind of relation between two components."
          },
          "note": {
            "maxLength": 500,
            "type": "string"
          },
          "policy": {
            "additionalProperties": false,
            "properties": {
              "concurrency": {
                "minimum": 0,
                "type": "integer"
              },
              "requiresApproval": {
                "type": "boolean"
              },
              "retry": {
                "additionalProperties": false,
                "properties": {
                  "backoff": {
                    "anyOf": [
                      {
                        "const": "none",
                        "type": "string"
                      },
                      {
                        "const": "fixed",
                        "type": "string"
                      },
                      {
                        "const": "exponential",
                        "type": "string"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "bounded": {
                    "description": "False when no attempt ceiling could be established.",
                    "type": "boolean"
                  },
                  "idempotency": {
                    "anyOf": [
                      {
                        "const": "declared",
                        "type": "string"
                      },
                      {
                        "const": "absent",
                        "type": "string"
                      },
                      {
                        "const": "unknown",
                        "type": "string"
                      }
                    ]
                  },
                  "maxAttempts": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "bounded",
                  "backoff",
                  "idempotency"
                ],
                "type": "object"
              },
              "timeoutMs": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "to": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "exclude": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1000,
          "type": "string"
        },
        "ecosystem": {
          "anyOf": [
            {
              "const": "javascript",
              "type": "string"
            },
            {
              "const": "python",
              "type": "string"
            },
            {
              "const": "other",
              "type": "string"
            }
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "components",
    "edges"
  ],
  "type": "object"
}
