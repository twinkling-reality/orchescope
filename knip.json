{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "playwright.config.ts", "tests/**/*.test.ts"],
      "project": ["scripts/**/*.mjs", "tests/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["oxc-parser", "tree-sitter-python", "web-tree-sitter"]
    },
    "apps/demo": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": ["**/dist/**"],
  "ignoreDependencies": ["@playwright/test"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false,
  "rules": {
    "classMembers": "off",
    "enumMembers": "off",
    "duplicates": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error"
  }
}
