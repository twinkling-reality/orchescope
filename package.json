{
  "name": "orchescope-workspace",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for Orchescope: map, test, and improve agent systems.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deps && pnpm unused && pnpm schemas:verify",
    "corpus": "node scripts/corpus.mjs --check",
    "corpus:exercise": "node scripts/corpus.mjs --check --exercise",
    "corpus:offline": "node scripts/corpus.mjs --check --offline",
    "corpus:required": "node scripts/corpus.mjs --check --required",
    "demo": "node apps/demo/src/main.ts",
    "deps": "depcruise packages apps scripts --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise packages apps --config .dependency-cruiser.cjs --output-type dot",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "orchescope": "node apps/cli/src/main.ts",
    "package": "node scripts/package.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "schemas": "node scripts/emit-schemas.mjs",
    "schemas:verify": "node scripts/emit-schemas.mjs --check",
    "test": "node --test --test-reporter=spec \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/test/**\" --test-coverage-exclude=\"**/testkit/**\" \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\"",
    "test:e2e": "node --test --test-timeout=180000 --test-reporter=spec \"tests/e2e/**/*.test.ts\"",
    "test:metamorphic": "node --test --test-timeout=180000 --test-reporter=spec packages/discovery/test/adapters.test.ts packages/discovery/test/agentflow.test.ts packages/discovery/test/browser-use-agent.test.ts packages/discovery/test/configurable-producers.test.ts packages/discovery/test/documentation-strings.test.ts packages/discovery/test/framework-provider-identity.test.ts packages/discovery/test/langchain-legacy-agent.test.ts packages/discovery/test/langchain-prompt-template.test.ts packages/discovery/test/nested-module-binding.test.ts packages/discovery/test/prompt-lexical-identity.test.ts packages/discovery/test/prompt-producer-contracts.test.ts packages/discovery/test/prompt-provider-boundaries.test.ts packages/discovery/test/prompt-source-settlement.test.ts packages/discovery/test/provider-qualified-effects.test.ts packages/discovery/test/retry-reading.test.ts packages/discovery/test/runtime-symbol-matching.test.ts packages/findings/test/claim-evidence.test.ts packages/findings/test/experiment-evidence.test.ts packages/findings/test/runtime-rules.test.ts packages/findings/test/semantic-identity.test.ts packages/findings/test/static-rules.test.ts packages/findings/test/topology-completeness.test.ts packages/report/test/evidence-selection.test.ts tests/e2e/configurable-model-effects.test.ts tests/e2e/corpus-acceptance.test.ts tests/e2e/object-method-effects.test.ts",
    "tour": "node scripts/tour.mjs",
    "typecheck": "tsc --noEmit",
    "unused": "knip",
    "verify": "pnpm check && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.1.0",
    "esbuild": "0.28.1",
    "knip": "6.29.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
