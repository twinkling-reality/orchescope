{
  "name": "orchescope",
  "version": "0.10.1",
  "description": "A local test harness for AI agent systems. Compare the same work before and after a change.",
  "license": "Apache-2.0",
  "author": "Glendon Chin",
  "homepage": "https://github.com/twinkling-reality/orchescope#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinkling-reality/orchescope.git"
  },
  "bugs": {
    "url": "https://github.com/twinkling-reality/orchescope/issues"
  },
  "type": "module",
  "keywords": [
    "agents",
    "ai-agents",
    "testing",
    "regression-testing",
    "cli",
    "observability",
    "opentelemetry",
    "mcp",
    "static-analysis",
    "chaos-engineering",
    "benchmark"
  ],
  "bin": {
    "orchescope": "./dist/orchescope.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@orchescope/benchmark": "workspace:*",
    "@orchescope/domain": "workspace:*",
    "@orchescope/goals": "workspace:*",
    "@orchescope/mcp": "workspace:*",
    "@orchescope/observability": "workspace:*",
    "@orchescope/report": "workspace:*",
    "@orchescope/schema": "workspace:*",
    "@orchescope/source-analysis": "workspace:*",
    "@orchescope/usecases": "workspace:*",
    "@orchescope/workspace": "workspace:*",
    "commander": "15.0.0",
    "oxc-parser": "0.147.0",
    "tree-sitter-python": "0.25.0",
    "web-tree-sitter": "0.26.13"
  }
}
